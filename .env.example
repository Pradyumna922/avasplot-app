# .env example for avasplot-app
# Copy this file to .env and fill in your real values

# Appwrite
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your-appwrite-database-id
EXPO_PUBLIC_APPWRITE_BUCKET_IMAGES=images

# Google Gemini
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# Groq
EXPO_PUBLIC_GROQ_API_KEY=your-groq-api-key

# PayU (example, update as needed)
EXPO_PUBLIC_PAYU_API_KEY=your-payu-api-key
EXPO_PUBLIC_PAYU_MERCHANT_ID=your-payu-merchant-id

# Add any other API keys or secrets below
# EXPO_PUBLIC_OTHER_API_KEY=your-other-api-key
